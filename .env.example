# ==============================================================================
# RHODIUM IMPACT CONSULTING LTD — Environment Configuration
# ==============================================================================

# Public Production URL (used for OpenGraph and Sitemap metadata)
NEXT_PUBLIC_SITE_URL=https://rhodiumimpact.com

# Internal Email Destination (Where consultation bookings and RFP enquiries are sent)
NOTIFICATION_EMAIL=info@rhodiumimpact.com

# Email Transmission Service (Resend)
# Obtain an API key at https://resend.com
RESEND_API_KEY=

# Default Sender Identity
EMAIL_FROM=Rhodium Impact <notifications@rhodiumimpact.com>

# Newsletter Service Integration (Optional - Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Analytics Integration (Optional)
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Plausible Analytics Domain (e.g., rhodiumimpact.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
